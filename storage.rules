rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.members;
    }

    match /chatMedia/{conversationId}/{allPaths=**} {
      allow read, write: if isConversationMember(conversationId);
    }
  }
}
