{
  "expo": {
    "name": "Stage 5 Chat",
    "slug": "stage-5-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "stage5chat",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record audio messages.",
        "NSPhotoLibraryUsageDescription": "Pick photos and videos for chat messages."
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.d33n.stage5chat"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose images and videos to send in chat."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Record audio messages."
        }
      ]
    ],
    "extra": {
      "firebaseApiKey": "AIzaSyAC_IlSwQopePYb2xI5RyF-DI2_DCKU7zw",
      "firebaseAuthDomain": "chatapp-971ae.firebaseapp.com",
      "firebaseProjectId": "chatapp-971ae",
      "firebaseStorageBucket": "chatapp-971ae.firebasestorage.app",
      "firebaseMessagingSenderId": "999108386647",
      "firebaseAppId": "1:999108386647:web:61ca21e27167c3b15c6812"
    }
  }
}
